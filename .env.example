# AWS Primary Account Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USERNAME=

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/aws_admin

# AWS Cognito — REQUIRED.
# The app fails closed without these: every route returns 401 / redirects to
# /login. Deploying without them is what caused INC1758541.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Region of the user pool. Defaults to ADMIN_AWS_REGION, then AWS_REGION.
# Set explicitly when the pool lives in a different region than the app.
COGNITO_REGION=

# Application
APP_URL=http://localhost:3000

# Local development only: skips authentication entirely.
# Ignored whenever NODE_ENV=production, so it cannot reopen a deployment.
# AUTH_DEV_BYPASS=true
